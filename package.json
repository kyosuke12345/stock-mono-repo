{
  "name": "stock-monorepo",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "db:up": "docker compose up -d",

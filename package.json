    "prisma:studio": "turbo run prisma:studio",
    "seed": "turbo run seed"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  }
